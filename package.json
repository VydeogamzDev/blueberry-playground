{
  "name": "blueberry-playground",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "standalone": "tsc --noEmit && node tools/standalone.mjs",
    "desktop": "tsc --noEmit && node tools/desktop.mjs",
    "desktop:build": "tsc --noEmit && node tools/desktop.mjs --package",
    "desktop:mac": "tsc --noEmit && node tools/desktop.mjs --mac",
    "test": "node tools/selftest.mjs",
    "test:touch": "node tools/touchtest.mjs",
    "bench": "node tools/selftest.mjs --bench",
    "mixcheck": "node tools/selftest.mjs --mix",
    "sfxaudit": "python tools/sfxaudit.py",
    "sheet": "vitest run --config tools/vitest.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "file:vendor/rapier/rapier2d-compat",
    "@dimforge/rapier2d-simd-compat": "file:vendor/rapier/rapier2d-simd-compat",
    "@dimforge/rapier2d-simd-mt-compat": "file:vendor/rapier/rapier2d-simd-mt-compat",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/tiny5": "^5.3.0",
    "peerjs": "^1.5.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
