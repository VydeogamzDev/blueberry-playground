diff --git a/bindings/typescript/rapier-compat/src2d-mt/init.ts b/bindings/typescript/rapier-compat/src2d-mt/init.ts
new file mode 100644
index 00000000..a68ad27d
--- /dev/null
+++ b/bindings/typescript/rapier-compat/src2d-mt/init.ts
@@ -0,0 +1,52 @@
+// @ts-ignore
+import wasmBase64 from "../pkg/dist/rapier_wasm2d_bg.wasm";
+import wasmInit, {
+    initSync,
+    initThreadPool as rawInitThreadPool,
+    runThreadPoolWorker as rawRunThreadPoolWorker,
+    threadPoolShare,
+} from "../pkg/dist/rapier_wasm2d";
+import base64 from "base64-js";
+
+/**
+ * Initializes RAPIER.
+ * Has to be called and awaited before using any library methods.
+ *
+ * (This build's memory is shared, which needs a cross-origin isolated page.)
+ */
+export async function init() {
+    await wasmInit({
+        module_or_path: base64.toByteArray(wasmBase64 as unknown as string)
+            .buffer,
+    });
+}
+
+/** What a worker running a thread of the pool needs (see `initWorker`). */
+export interface ThreadShare {
+    module: WebAssembly.Module;
+    memory: WebAssembly.Memory;
+}
+
+/**
+ * Makes the pool of threads that every physics pipeline (so every world) made afterwards
+ * steps on: the calling thread, which works on each step with the rest and waits for them by
+ * spinning, and `threads` more, each waiting for a worker to run it: start `threads` module
+ * workers, post each what this returns, have each call `initWorker` with it and then
+ * `runThreadPoolWorker`, and let them start (they can't while the calling thread keeps busy)
+ * before stepping.
+ */
+export function initThreadPool(threads: number): ThreadShare {
+    rawInitThreadPool(threads);
+    const [module, memory] = threadPoolShare();
+    return {module, memory};
+}
+
+/** In a worker: instantiates RAPIER on the memory of the thread that made the pool. */
+export function initWorker(share: ThreadShare) {
+    initSync(share);
+}
+
+/** In a worker, after `initWorker`: runs a thread of the pool, never returning. */
+export function runThreadPoolWorker() {
+    rawRunThreadPoolWorker();
+}
