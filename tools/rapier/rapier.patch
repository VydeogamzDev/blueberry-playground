diff --git a/bindings/typescript/src/alloc.rs b/bindings/typescript/src/alloc.rs
new file mode 100644
index 00000000..3f0fde43
--- /dev/null
+++ b/bindings/typescript/src/alloc.rs
@@ -0,0 +1,68 @@
+//! The threaded build's allocator (feature `threads`): Rust's own (dlmalloc), with the memory
+//! grown a lot at a time.
+//!
+//! Growing a memory the threads share stops every one of them (each is interrupted, to see the
+//! memory's new size), and dlmalloc grows it by what it needs there and then: a few pages at a
+//! time, dozens of times a step in a heap of ragdolls just crushed, whose contacts then took
+//! twice as long to work out, however many threads worked on them.
+
+use core::arch::wasm32::memory_size;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+/// What the memory is grown by, once dlmalloc has grown it past the last of that (bytes).
+const GROW: usize = 16 << 20;
+const PAGE: usize = 64 << 10;
+
+/// The memory's size (pages) after it was last grown by `GROW`, and whether it is being.
+static GROWN: AtomicUsize = AtomicUsize::new(0);
+static GROWING: AtomicBool = AtomicBool::new(false);
+
+struct Growing;
+
+#[global_allocator]
+static ALLOCATOR: Growing = Growing;
+
+/// `p` (from dlmalloc), and if dlmalloc has grown the memory since it was last grown by `GROW`,
+/// the memory grown by `GROW` more: allocated and freed again, dlmalloc keeps that for later.
+#[inline]
+fn grown(p: *mut u8) -> *mut u8 {
+    if memory_size::<0>() > GROWN.load(Ordering::Relaxed) && !GROWING.swap(true, Ordering::Acquire) {
+        // (another thread may have grown it before this one got here)
+        if memory_size::<0>() > GROWN.load(Ordering::Relaxed) {
+            // SAFETY: a non-zero size, aligned to 8.
+            let room = unsafe { Layout::from_size_align_unchecked(GROW - PAGE, 8) };
+            unsafe {
+                let q = System.alloc(room);
+                if !q.is_null() {
+                    System.dealloc(q, room);
+                }
+            }
+            GROWN.store(memory_size::<0>(), Ordering::Relaxed);
+        }
+        GROWING.store(false, Ordering::Release);
+    }
+    p
+}
+
+unsafe impl GlobalAlloc for Growing {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        grown(unsafe { System.alloc(layout) })
+    }
+
+    #[inline]
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        grown(unsafe { System.alloc_zeroed(layout) })
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        grown(unsafe { System.realloc(ptr, layout, new_size) })
+    }
+}
