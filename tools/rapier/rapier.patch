diff --git a/bindings/typescript/src/threads.rs b/bindings/typescript/src/threads.rs
new file mode 100644
index 00000000..680bac9a
--- /dev/null
+++ b/bindings/typescript/src/threads.rs
@@ -0,0 +1,62 @@
+//! A pool of threads, each run by a Web Worker sharing this module's memory, that every
+//! physics pipeline made after `initThreadPool` steps on (feature `threads`).
+//!
+//! The thread that makes the pool (the page's) is one of its threads too: it works on each step
+//! with the others, and waits for them by spinning (rayon-core is patched for that, see
+//! tools/rapier), since a browser's main thread may never block. The JS hooks are never called
+//! (see `NativeHooks`): they can't be from the workers.
+
+use rayon::{ThreadBuilder, ThreadPool, ThreadPoolBuilder};
+use std::sync::{Arc, Mutex, OnceLock};
+use wasm_bindgen::prelude::*;
+
+static POOL: OnceLock<Arc<ThreadPool>> = OnceLock::new();
+/// The pool's threads, until a worker takes each (see `runThreadPoolWorker`).
+static WAITING: Mutex<Vec<ThreadBuilder>> = Mutex::new(Vec::new());
+
+/// Makes the pool: this thread and `threads` more, which wait for workers to run them (see
+/// `runThreadPoolWorker`): start that many, all sharing this module and its memory, and let
+/// them start (yield to the event loop) before stepping a pipeline made after this.
+#[wasm_bindgen]
+pub fn initThreadPool(threads: usize) {
+    if POOL.get().is_some() {
+        return;
+    }
+    // A panic aborts its thread here, and whoever waits on its work would wait forever.
+    let default_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(move |info| {
+        rayon_core::pool_thread_panicked();
+        default_hook(info);
+    }));
+    rayon_core::never_sleep_on_this_thread();
+    let pool = ThreadPoolBuilder::new()
+        .num_threads(threads + 1)
+        .use_current_thread()
+        .spawn_handler(|thread| {
+            WAITING.lock().unwrap().push(thread);
+            Ok(())
+        })
+        .build()
+        .expect("couldn't make the thread pool");
+    let _ = POOL.set(Arc::new(pool));
+}
+
+/// This module and its memory, `[module, memory]`: what each worker running a thread of the
+/// pool (see `runThreadPoolWorker`) instantiates.
+#[wasm_bindgen]
+pub fn threadPoolShare() -> js_sys::Array {
+    js_sys::Array::of2(&wasm_bindgen::module(), &wasm_bindgen::memory())
+}
+
+/// Runs one of the pool's threads on this worker, never returning.
+#[wasm_bindgen]
+pub fn runThreadPoolWorker() {
+    let thread = WAITING.lock().unwrap().pop();
+    let thread = thread.expect("no thread of the pool is left to run");
+    thread.run();
+}
+
+/// The pool, once made.
+pub(crate) fn pool() -> Option<Arc<ThreadPool>> {
+    POOL.get().cloned()
+}
